#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./electron/scripts/build_macos [additional electron-builder arguments]"
  echo
  echo "Environment:"
  echo "  CLAWNSOLE_ELECTRON_ARCH  arm64, x64, or universal (default: current Mac)"
  echo "  CLAWNSOLE_ELECTRON_SIGN  Set to true to enable Developer ID signing"
  echo "                            and notarization"
  echo "  CLAWNSOLE_NOTARY_KEYCHAIN_PROFILE"
  echo "                            notarytool profile for local signed builds"
  echo "                            (default: clawnsole-notarization)"
  echo "  CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID"
  echo "                            optional Google Desktop OAuth client"
  echo "  CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET"
  echo "                            matching installed-app client value"
  exit 0
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "The Clawnsole macOS build requires macOS." >&2
  exit 1
fi

print_heading "macOS deployable build"
prepare_dependencies
node "$ELECTRON_DIRECTORY/scripts/clean-output.mjs"

if [[ "${CLAWNSOLE_ELECTRON_SIGN:-false}" != "true" ]]; then
  export CSC_IDENTITY_AUTO_DISCOVERY=false
  # GitHub exposes unset secrets as empty environment variables. electron-builder
  # interprets an empty CSC_LINK as a relative certificate path, so remove both
  # signing variables entirely for an unsigned build.
  unset CSC_LINK CSC_KEY_PASSWORD
elif [[ -z "${APPLE_ID:-}" &&
        -z "${APPLE_APP_SPECIFIC_PASSWORD:-}" &&
        -z "${APPLE_API_KEY:-}" &&
        -z "${APPLE_KEYCHAIN_PROFILE:-}" ]]; then
  # Local distribution builds use a notarytool profile so the app-specific
  # password stays in the login Keychain instead of the shell environment.
  export APPLE_KEYCHAIN_PROFILE="${CLAWNSOLE_NOTARY_KEYCHAIN_PROFILE:-clawnsole-notarization}"
fi

cd "$REPOSITORY_ROOT"
CLAWNSOLE_PROXY_URL= "$FLUTTER_DIRECTORY/scripts/build_web"
ARCHITECTURE="${CLAWNSOLE_ELECTRON_ARCH:-$(uname -m)}"
node "$ELECTRON_DIRECTORY/scripts/prepare-renderer.mjs"
CLAWNSOLE_MEDIA_TOOLS_ARCH="$ARCHITECTURE" \
  "$ELECTRON_DIRECTORY/scripts/prepare-media-tools"
"$ELECTRON_DIRECTORY/scripts/prepare-session-title-helper" "$ARCHITECTURE"
"$ELECTRON_DIRECTORY/scripts/prepare_icon"

case "$ARCHITECTURE" in
  arm64) ARCH_FLAG="--arm64" ;;
  x64|x86_64) ARCH_FLAG="--x64" ;;
  universal) ARCH_FLAG="--universal" ;;
  *)
    echo "CLAWNSOLE_ELECTRON_ARCH must be arm64, x64, or universal." >&2
    exit 1
    ;;
esac

cd "$ELECTRON_DIRECTORY"
./node_modules/.bin/electron-builder --mac dmg zip "$ARCH_FLAG" "$@"

echo
echo "macOS release artifacts: $ELECTRON_DIRECTORY/dist/release"
echo "Local .app bundles are inside the mac-* release directory."
