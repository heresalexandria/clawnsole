{
  "name": "clawnsole-electron",
  "version": "0.44.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Clawnsole macOS desktop shell",
  "author": "Clawnsole contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "./scripts/start_macos",
    "build:mac": "./scripts/build_macos",
    "prepare:renderer": "node ./scripts/prepare-renderer.mjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.clawnsole.desktop",
    "productName": "Clawnsole",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/renderer",
        "to": "renderer"
      },
      {
        "from": "dist/companion",
        "to": "companion"
      },
      {
        "from": "dist/config",
        "to": "config"
      },
      {
        "from": "dist/media-tools",
        "to": "media-tools"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist/release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "title": "${productName} ${version}"
    }
  }
}
