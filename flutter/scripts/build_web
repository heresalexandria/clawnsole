#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/build_web [additional flutter build web arguments]"
  echo
  echo "The release bundle expects the companion to serve it from the same origin."
  echo "Set CLAWNSOLE_PROXY_URL to build for a separately hosted companion."
  exit 0
fi

print_heading "web release build"
prepare_flutter
require_command dart

PROXY_URL="${CLAWNSOLE_PROXY_URL-}"

# The companion serves this bundle from a loopback origin that now stays the
# same across launches; a service worker there would outlive an update and keep
# serving the previous bundle, so none is emitted.
flutter build web \
  --release \
  --source-maps \
  --pwa-strategy=none \
  --dart-define "CLAWNSOLE_PROXY_URL=$PROXY_URL" \
  --dart-define "FLUTTER_WEB_ENABLE_INSTRUMENTATION=true" \
  "${CLAWNSOLE_SITE_BUILD_ARGUMENT[@]}" \
  "$@"

dart compile exe \
  tool/clawnsole_companion.dart \
  -o build/clawnsole_companion

echo
echo "Web release: $FLUTTER_DIRECTORY/build/web"
echo "Companion executable: $FLUTTER_DIRECTORY/build/clawnsole_companion"
echo "Run the companion with --web-root $FLUTTER_DIRECTORY/build/web."
