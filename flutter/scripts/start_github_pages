#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/start_github_pages [additional flutter run arguments]"
  echo
  echo "Runs the backend-free browser target with Google Drive persistence."
  echo "Environment:"
  echo "  CLAWNSOLE_GOOGLE_CLIENT_ID  Google OAuth web client ID"
  echo "  CLAWNSOLE_WEB_PORT          Flutter web port (default: 7357)"
  exit 0
fi

print_heading "standalone browser development"
prepare_flutter

GOOGLE_CLIENT_ID="${CLAWNSOLE_GOOGLE_CLIENT_ID-}"
WEB_PORT="${CLAWNSOLE_WEB_PORT:-7357}"

echo "Opening standalone Flutter web at http://localhost:$WEB_PORT/…"
flutter run \
  -d chrome \
  --web-port "$WEB_PORT" \
  --dart-define "CLAWNSOLE_STANDALONE_WEB=true" \
  --dart-define "CLAWNSOLE_GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID" \
  "$@"
