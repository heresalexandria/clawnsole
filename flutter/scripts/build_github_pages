#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/build_github_pages [additional flutter build web arguments]"
  echo
  echo "Builds the backend-free Google Drive target into build/github-pages/app."
  echo "Environment:"
  echo "  CLAWNSOLE_GOOGLE_CLIENT_ID  Google OAuth web client ID"
  echo "  CLAWNSOLE_WEB_BASE_HREF     Pages path (default: /clawnsole/app/)"
  exit 0
fi

print_heading "standalone GitHub Pages build"
prepare_flutter

GOOGLE_CLIENT_ID="${CLAWNSOLE_GOOGLE_CLIENT_ID-}"
BASE_HREF="${CLAWNSOLE_WEB_BASE_HREF:-/clawnsole/app/}"

if [[ -z "$GOOGLE_CLIENT_ID" ]]; then
  echo "Warning: CLAWNSOLE_GOOGLE_CLIENT_ID is empty; Drive connect will be disabled." >&2
fi

flutter build web \
  --release \
  --base-href "$BASE_HREF" \
  --output build/github-pages/app \
  --dart-define "CLAWNSOLE_STANDALONE_WEB=true" \
  --dart-define "CLAWNSOLE_GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID" \
  "$@"

touch build/github-pages/app/.nojekyll

echo
echo "GitHub Pages app: $FLUTTER_DIRECTORY/build/github-pages/app"
echo "Publish this directory at ${BASE_HREF} without the local companion."
