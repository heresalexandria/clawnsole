#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/start_windows [additional flutter run arguments]"
  echo
  echo "Run this script from Windows or Git Bash with Visual Studio installed."
  echo "Optional Drive OAuth uses CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID and"
  echo "CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET."
  exit 0
fi

case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) ;;
  *)
    echo "The Clawnsole Windows app must be run on Windows." >&2
    exit 1
    ;;
esac

print_heading "Windows desktop"
prepare_flutter
"$FLUTTER_DIRECTORY/scripts/prepare_windows_media_tools"

OAUTH_RUN_ARGUMENTS=()
if [[ -n "${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID:-}" ]]; then
  OAUTH_RUN_ARGUMENTS+=(
    --dart-define "CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID=${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID}"
  )
fi
if [[ -n "${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET:-}" ]]; then
  OAUTH_RUN_ARGUMENTS+=(
    --dart-define "CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET=${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET}"
  )
fi

flutter run -d windows "${OAUTH_RUN_ARGUMENTS[@]}" "$@"
