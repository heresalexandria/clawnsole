#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/build_windows [additional flutter build windows arguments]"
  echo
  echo "Run this script from Windows or Git Bash with Visual Studio installed."
  echo "Provider credential Dart defines are rejected. Optional Google Desktop"
  echo "OAuth configuration is read from CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID"
  echo "and CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET."
  exit 0
fi

case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) ;;
  *)
    echo "The Clawnsole Windows build requires Windows." >&2
    exit 1
    ;;
esac

for argument in "$@"; do
  case "$argument" in
    --dart-define | --dart-define=* | --dart-define-from-file | --dart-define-from-file=*)
      echo "Windows release builds do not accept Dart defines." >&2
      exit 1
      ;;
  esac
done

unset DART_DEFINES
unset BFL_API_KEY LTX_API_KEY ARTCRAFT_KEY ATLAS_CLOUD_KEY
unset CLAWNSOLE_IOS_REVIEW_BFL_API_KEY CLAWNSOLE_IOS_REVIEW_BFL_API_KEY_ID
unset CLAWNSOLE_IOS_REVIEW_LTX_API_KEY CLAWNSOLE_IOS_REVIEW_LTX_API_KEY_ID
unset CLAWNSOLE_IOS_REVIEW_ATLAS_API_KEY CLAWNSOLE_IOS_REVIEW_ATLAS_API_KEY_ID
unset CLAWNSOLE_IOS_REVIEW_ARTCRAFT_API_KEY CLAWNSOLE_IOS_REVIEW_ARTCRAFT_API_KEY_ID

print_heading "Windows x64 release build"
prepare_flutter

OAUTH_BUILD_ARGUMENTS=()
if [[ -n "${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID:-}" ]]; then
  OAUTH_BUILD_ARGUMENTS+=(
    --dart-define "CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID=${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_ID}"
  )
fi
if [[ -n "${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET:-}" ]]; then
  OAUTH_BUILD_ARGUMENTS+=(
    --dart-define "CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET=${CLAWNSOLE_GOOGLE_DESKTOP_CLIENT_SECRET}"
  )
fi

flutter build windows --release "${OAUTH_BUILD_ARGUMENTS[@]}" "$@"

echo
echo "Windows release: $FLUTTER_DIRECTORY/build/windows/x64/runner/Release"
