#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
source "$SCRIPT_DIRECTORY/_review_credentials.sh"
source "$SCRIPT_DIRECTORY/_mobile_test_credentials.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/build_ios [additional flutter build ipa arguments]"
  echo
  echo "Environment:"
  echo "  CLAWNSOLE_IOS_EXPORT_METHOD  app-store, ad-hoc, development, or enterprise"
  echo "                                (default: app-store)"
  echo "  CLAWNSOLE_IOS_EXPORT_OPTIONS path to an ExportOptions.plist; overrides"
  echo "                                CLAWNSOLE_IOS_EXPORT_METHOD"
  echo "  INCLUDE_IOS_TEST_KEYS                   true to compile App Review keys"
  echo "                                          (default: false)"
  echo "  CLAWNSOLE_IOS_REVIEW_BFL_API_KEY       App Review BFL key"
  echo "  CLAWNSOLE_IOS_REVIEW_LTX_API_KEY       App Review LTX key"
  echo "  CLAWNSOLE_IOS_REVIEW_ATLAS_API_KEY     App Review Atlas Cloud key"
  echo "  CLAWNSOLE_IOS_REVIEW_ARTCRAFT_API_KEY  App Review ArtCraft key"
  echo "  Append _FILE to any key variable to load it from a one-line file"
  echo "  CLAWNSOLE_IOS_REVIEW_ENV_FILE           Optional shell env file"
  echo "                                           (default: flutter/.env.ios-review)"
  echo "  CLAWNSOLE_GOOGLE_IOS_CLIENT_ID           Google OAuth iOS client"
  echo "  CLAWNSOLE_MOBILE_TEST_BUILD               true for a labelled review build"
  echo "  ARTCRAFT_TEST_KEY                          version-gated review credential"
  exit 0
fi

PRODUCTION_BUILD=false
if [[ "${1:-}" == "--production" ]]; then
  PRODUCTION_BUILD=true
  shift
fi

print_heading "iOS deployable build"
prepare_flutter
require_command xcrun

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "iOS archives require macOS and Xcode." >&2
  exit 1
fi

EXPORT_METHOD="${CLAWNSOLE_IOS_EXPORT_METHOD:-app-store}"
EXPORT_OPTIONS="${CLAWNSOLE_IOS_EXPORT_OPTIONS:-}"
if [[ "$PRODUCTION_BUILD" == true ]]; then
  for argument in "$@"; do
    case "$argument" in
      --dart-define | --dart-define=* | --dart-define-from-file | --dart-define-from-file=*)
        echo "Production iOS builds do not accept custom Dart defines." >&2
        exit 1
        ;;
    esac
  done
  INCLUDE_IOS_TEST_KEYS=false
else
  load_clawnsole_review_credentials
fi
prepare_clawnsole_review_defines
prepare_clawnsole_mobile_test_defines
prepare_google_ios_oauth
trap 'cleanup_clawnsole_review_defines; cleanup_clawnsole_mobile_test_defines; cleanup_google_ios_oauth' EXIT

IOS_BUILD_ARGUMENTS=(--release)
IOS_BUILD_ARGUMENTS+=("${CLAWNSOLE_SITE_BUILD_ARGUMENT[@]}")
if [[ -n "$EXPORT_OPTIONS" ]]; then
  if [[ ! -f "$EXPORT_OPTIONS" ]]; then
    echo "CLAWNSOLE_IOS_EXPORT_OPTIONS does not exist: $EXPORT_OPTIONS" >&2
    exit 1
  fi
  IOS_BUILD_ARGUMENTS+=(--export-options-plist "$EXPORT_OPTIONS")
else
  IOS_BUILD_ARGUMENTS+=(--export-method "$EXPORT_METHOD")
fi
if [[ -n "$REVIEW_DEFINE_FILE" ]]; then
  IOS_BUILD_ARGUMENTS+=(--dart-define-from-file "$REVIEW_DEFINE_FILE")
fi
if [[ -n "$MOBILE_TEST_DEFINE_FILE" ]]; then
  IOS_BUILD_ARGUMENTS+=(--dart-define-from-file "$MOBILE_TEST_DEFINE_FILE")
fi
if [[ -n "${CLAWNSOLE_GOOGLE_IOS_CLIENT_ID:-}" ]]; then
  IOS_BUILD_ARGUMENTS+=(
    --dart-define "CLAWNSOLE_GOOGLE_IOS_CLIENT_ID=${CLAWNSOLE_GOOGLE_IOS_CLIENT_ID}"
  )
fi
IOS_BUILD_ARGUMENTS+=("$@")

"$REPOSITORY_ROOT/scripts/prepare_platform_icons" ios

flutter build ipa "${IOS_BUILD_ARGUMENTS[@]}"

echo
echo "iOS archive: $FLUTTER_DIRECTORY/build/ios/archive/Runner.xcarchive"
echo "IPA output: $FLUTTER_DIRECTORY/build/ios/ipa"
