#!/usr/bin/env bash

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
source "$SCRIPT_DIRECTORY/_review_credentials.sh"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./scripts/build_ios [additional flutter build ipa arguments]"
  echo
  echo "Environment:"
  echo "  CLAWNSOLE_IOS_EXPORT_METHOD  app-store, ad-hoc, development, or enterprise"
  echo "                                (default: app-store)"
  echo "  CLAWNSOLE_IOS_REVIEW_BFL_API_KEY       App Review BFL key"
  echo "  CLAWNSOLE_IOS_REVIEW_LTX_API_KEY       App Review LTX key"
  echo "  CLAWNSOLE_IOS_REVIEW_ATLAS_API_KEY     App Review Atlas Cloud key"
  echo "  CLAWNSOLE_IOS_REVIEW_ARTCRAFT_API_KEY  App Review ArtCraft key"
  echo "  Append _FILE to any key variable to load it from a one-line file"
  echo "  CLAWNSOLE_IOS_REVIEW_ENV_FILE           Optional shell env file"
  echo "                                           (default: flutter/.env.ios-review)"
  echo "  CLAWNSOLE_GOOGLE_IOS_CLIENT_ID           Google OAuth iOS client"
  exit 0
fi

print_heading "iOS deployable build"
prepare_flutter
require_command xcrun

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "iOS archives require macOS and Xcode." >&2
  exit 1
fi

EXPORT_METHOD="${CLAWNSOLE_IOS_EXPORT_METHOD:-app-store}"
load_clawnsole_review_credentials
prepare_clawnsole_review_defines
prepare_google_ios_oauth
trap 'cleanup_clawnsole_review_defines; cleanup_google_ios_oauth' EXIT

OAUTH_BUILD_ARGUMENTS=()
if [[ -n "${CLAWNSOLE_GOOGLE_IOS_CLIENT_ID:-}" ]]; then
  OAUTH_BUILD_ARGUMENTS+=(
    --dart-define "CLAWNSOLE_GOOGLE_IOS_CLIENT_ID=${CLAWNSOLE_GOOGLE_IOS_CLIENT_ID}"
  )
fi

"$REPOSITORY_ROOT/scripts/prepare_platform_icons" ios

flutter build ipa \
  --release \
  --export-method "$EXPORT_METHOD" \
  "${REVIEW_BUILD_ARGUMENTS[@]}" \
  "${OAUTH_BUILD_ARGUMENTS[@]}" \
  "$@"

echo
echo "iOS archive: $FLUTTER_DIRECTORY/build/ios/archive/Runner.xcarchive"
echo "IPA output: $FLUTTER_DIRECTORY/build/ios/ipa"
