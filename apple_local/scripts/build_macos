#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIRECTORY="$(cd "$SCRIPT_DIRECTORY/.." && pwd)"
OUTPUT_DIRECTORY="$PACKAGE_DIRECTORY/build"
APP_DIRECTORY="$OUTPUT_DIRECTORY/Clawnsole Apple Local.app"
APP_CONTENTS="$APP_DIRECTORY/Contents"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "The Apple Local helper can only be built on macOS." >&2
  exit 1
fi

swift build \
  --package-path "$PACKAGE_DIRECTORY" \
  --configuration release \
  --product clawnsole-apple-generator

BIN_DIRECTORY="$(swift build \
  --package-path "$PACKAGE_DIRECTORY" \
  --configuration release \
  --show-bin-path)"
mkdir -p "$OUTPUT_DIRECTORY"
cp "$BIN_DIRECTORY/clawnsole-apple-generator" \
  "$OUTPUT_DIRECTORY/clawnsole_apple_generator"
chmod 755 "$OUTPUT_DIRECTORY/clawnsole_apple_generator"
mkdir -p "$APP_CONTENTS/MacOS"
cp "$BIN_DIRECTORY/clawnsole-apple-generator" \
  "$APP_CONTENTS/MacOS/clawnsole_apple_generator"
cp "$PACKAGE_DIRECTORY/Resources/Info.plist" "$APP_CONTENTS/Info.plist"
chmod 755 "$APP_CONTENTS/MacOS/clawnsole_apple_generator"

echo "Apple Local helper: $APP_DIRECTORY"
